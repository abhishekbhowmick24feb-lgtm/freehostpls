# Copy this file to .env and fill in your values.
DISCORD_TOKEN=your-bot-token-here

# Prefix used before a server sets its own.
DEFAULT_PREFIX=!

# Keep settings.json in a private channel named #settings-backup so a host with
# no disk keeps its settings. On by default; set to 0 to switch it off.
# STATE_BACKUP=0
# Optional: pin the backup channel by ID instead of by name.
# STATE_BACKUP_CHANNEL_ID=123456789012345678
